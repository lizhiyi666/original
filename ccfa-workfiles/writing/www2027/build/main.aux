\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textsc  {PCDG}\xspace  (schematic). (a) Frozen reverse loop and terminal refinement. (b) Category order/existence energies and POI distance KL, anchored by base-to-projected token KL. (c) Category-filtered POI reselection reuses Gumbel noise. (d) Same-frame refinement preserves actual categories, times, length, and order. Dashed edges carry conditions/objectives. Intermediate steps allow POI masks and leave unresolved categories unfiltered. Unsupported final categories allow any catalog POI, permitting nonzero mismatch.}}{3}{figure.caption.6}\protected@file@percent }
\newlabel{fig:framework}{{2}{3}{\pcdg (schematic). (a) Frozen reverse loop and terminal refinement. (b) Category order/existence energies and POI distance KL, anchored by base-to-projected token KL. (c) Category-filtered POI reselection reuses Gumbel noise. (d) Same-frame refinement preserves actual categories, times, length, and order. Dashed edges carry conditions/objectives. Intermediate steps allow POI masks and leave unresolved categories unfiltered. Unsupported final categories allow any catalog POI, permitting nonzero mismatch}{figure.caption.6}{}}
